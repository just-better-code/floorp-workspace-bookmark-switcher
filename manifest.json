{
  "manifest_version": 2,
  "name": "Floorp Bookmark Toolbar Autoswitch",
  "version": "0.2.2",
  "homepage_url": "https://github.com/just-better-code/floorp-workspace-bookmark-switcher",
  "experiment_apis": {
    "floorpWorkspaceBars": {
      "schema": "experiments/floorp.json",
      "parent": {
        "scopes": [
          "addon_parent"
        ],
        "paths": [
          [
            "floorpWorkspaceBars"
          ]
        ],
        "script": "experiments/floorp.js"
      }
    }
  },
  "description": "For Floorp only; not compatible with Firefox. Automatically switch bookmark toolbars with Floorp workspaces and share toolbars across workspaces.",
  "browser_specific_settings": {
    "gecko": {
      "id": "bookmark-toolbar-autoswitch@just-better-code",
      "update_url": "https://github.com/just-better-code/floorp-workspace-bookmark-switcher/releases/latest/download/updates.json",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "background": {
    "scripts": [
      "background.js"
    ],
    "persistent": true
  },
  "icons": {
    "16": "icons/icon.png",
    "32": "icons/icon.png",
    "64": "icons/icon.png",
    "128": "icons/icon.png"
  },
  "permissions": [
    "bookmarks"
  ],
  "content_security_policy": "script-src 'self'; object-src 'self'"
}
